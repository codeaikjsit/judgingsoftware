rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check if authenticated user has admin role
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function: Check if current user is the specific judge
    function isJudge(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isJudge(userId) && request.resource.data.role == resource.data.role);
    }
    
    // TEAMS COLLECTION
    match /teams/{teamId} {
      allow read: if true; // Public/Leaderboard can read
      allow write: if isAdmin();
    }
    
    // ACTIVE SESSION (SINGLETON)
    match /active_session/{sessionId} {
      allow read: if true;
      allow write: if isAdmin(); // Only admins can change the active pitching team
    }
    
    // SCORES COLLECTION
    match /scores/{scoreId} {
      // Judges can only read their own scores; Admins can read all scores
      allow read: if isAdmin() || (isAuthenticated() && resource.data.judge_id == request.auth.uid);
      
      // Judges can only create a score for themselves, with valid 1-10 scores,
      // and only if the team is currently active and status is 'pitching'
      allow create: if isAuthenticated() && 
        request.resource.data.judge_id == request.auth.uid &&
        request.resource.data.tech_score >= 1 && request.resource.data.tech_score <= 10 &&
        request.resource.data.impact_score >= 1 && request.resource.data.impact_score <= 10 &&
        request.resource.data.problem_score >= 1 && request.resource.data.problem_score <= 10 &&
        request.resource.data.innovation_score >= 1 && request.resource.data.innovation_score <= 10 &&
        request.resource.data.presentation_score >= 1 && request.resource.data.presentation_score <= 10 &&
        request.resource.data.ux_score >= 1 && request.resource.data.ux_score <= 10 &&
        get(/databases/$(database)/documents/active_session/current).data.active_team_id == request.resource.data.team_id &&
        get(/databases/$(database)/documents/active_session/current).data.status == 'pitching';
        
      allow update, delete: if isAdmin();
    }
    
    // LEADERBOARD / AGGREGATED VIEW (Generated by Cloud Functions or Admin)
    match /leaderboard/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
